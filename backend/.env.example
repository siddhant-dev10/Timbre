# Mac-local FastAPI development settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
DATABASE_URL=sqlite:///./data/timbre.db

# NVIDIA Build OpenAI-compatible API. Put your key only in backend/.env.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_TOKENS=400
NVIDIA_TEMPERATURE=1.0
NVIDIA_TOP_P=0.95
NVIDIA_REASONING_EFFORT=none

# Bolna is the phone/SIP orchestration provider. Credentials and agent setup
# are required only when you intentionally prepare for an approved live test.
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_TIMEOUT_SECONDS=30
BOLNA_WEBHOOK_SECRET=
BOLNA_TEST_AGENT_VERIFIED=false

# Optional dedicated Bearer token for securing /v1/chat/completions (Bolna Custom LLM)
TIMBRE_LLM_API_KEY=

# Optional ElevenLabs TTS. Existing multilingual model is preserved.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=30

# WhatsApp Business Cloud API (Official Meta Graph API v21.0)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TIMEOUT_SECONDS=15

# OpenWA Local WhatsApp Gateway Integration
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=timbre
OPENWA_WEBHOOK_SECRET=
OPENWA_TIMEOUT_SECONDS=15

# Outbound phone calls remain disabled.
ENABLE_REAL_CALLS=false
