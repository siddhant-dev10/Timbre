# Timbre Backend Configuration (Development / Buildathon Prototype)

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080,app://*,http://192.168.0.123:8000

# Database
DATABASE_URL=sqlite:///./data/timbre.db

# Synthetic Reference Date for Demographic Calculations (YYYY-MM-DD)
REFERENCE_DATE=2026-10-28

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_NUM_CTX=4096

# Bolna.ai Voice Agent Integration
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_TIMEOUT_SECONDS=30.0

# ElevenLabs Text-to-Speech Integration (Custom Timbre Voice)
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=30.0

# CALL SAFETY INVARIANT:
# Real calls are strictly disabled by default.
ENABLE_REAL_CALLS=false
