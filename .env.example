# Copy settings into backend/.env and add secrets locally. Never commit credentials.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEBHOOK_SECRET=
BOLNA_TEST_AGENT_VERIFIED=false
TIMBRE_LLM_API_KEY=
ENABLE_REAL_CALLS=false

# Official WhatsApp Business Cloud API settings
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# OpenWA Local WhatsApp Gateway Integration
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=timbre
OPENWA_WEBHOOK_SECRET=
OPENWA_TIMEOUT_SECONDS=15

